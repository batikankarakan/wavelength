@model ArtistPageVm
@using Wavelength.Web.Infrastructure
@{
    var a = Model.Artist;
    var here = "/artists/" + a.Id;
    var color = Fmt.ColorFor(a.Id);
}
<section class="relative border-b-2 border-ink pt-[66px]">
  <div class="relative h-56 overflow-hidden border-b-2 border-ink md:h-72" style="background:@color">
    @if (a.BannerUrl != null) { <img src="@a.BannerUrl" alt="" class="absolute inset-0 h-full w-full object-cover"> }
    <div class="halftone absolute inset-0 opacity-20"></div>
    <div class="absolute inset-x-0 bottom-0 -rotate-1 border-y-2 border-ink bg-ink py-2 text-volt">
      <div class="marquee flex w-max gap-8 whitespace-nowrap font-display text-3xl uppercase">
        @for (var n = 0; n < 2; n++) { for (var k = 0; k < 6; k++) { <span>@a.StageName ✱</span> } }
      </div>
    </div>
  </div>
  <div class="mx-auto max-w-7xl px-6 pb-14">
    <div class="-mt-20 flex flex-col gap-6 md:flex-row md:items-end">
      <div class="relative w-40 shrink-0 bg-paper md:w-52" data-tilt="6">
        <div class="shadow-brut">@Html.Cover(new CoverVm { Url = Model.AvatarUrl, Color = color, Label = a.StageName })</div>
      </div>
      <div class="min-w-0 flex-1">
        <div class="flex flex-wrap gap-2">
          @if (a.Verified) { <span class="sticker bg-cobalt text-paper">✓ Verified artist</span> }
          @if (a.Country != null) { <span class="sticker bg-paper">⌖ @a.Country</span> }
        </div>
        <h1 data-hop class="display mt-4 break-words text-[clamp(3.5rem,9vw,8rem)]">@a.StageName</h1>
      </div>
      <div class="flex flex-wrap gap-3 md:pb-3">
        @if (Model.TopTracks.Any()) { <button type="button" data-play-all="@string.Join(",", Model.TopTracks.Select(t => t.Id))" class="btn-ink">▶ Play</button> }
        @if (Model.IsSelf) { <a href="/studio" class="btn-volt">Open studio →</a> }
        else { @Html.Partial("_PubFollow", new PubFollowVm(a.UserId, Model.Following, here, "")) }
      </div>
    </div>
    <div class="mt-10 grid gap-8 lg:grid-cols-[1.3fr_1fr]">
      <div data-reveal>
        <p class="eyebrow">/ Bio</p>
        <p class="mt-3 max-w-2xl text-xl font-medium">@(Model.Bio ?? "No bio yet. The music will have to speak for itself.")</p>
        <div class="mt-4 flex flex-wrap gap-4 font-mono text-sm">
          @if (a.Website != null) { <a href="@a.Website" target="_blank" rel="noopener nofollow" class="font-bold underline hover:bg-volt">↗ @a.Website.Replace("https://", "").Replace("http://", "")</a> }
          <a href="/users/@Model.Username" class="font-bold underline hover:bg-volt">@@@Model.Username</a>
        </div>
      </div>
      <dl class="grid grid-cols-2 border-2 border-ink bg-white shadow-brut" data-reveal="100">
        <div class="border-b-2 border-r-2 border-ink p-4"><dt class="eyebrow text-xs">Followers</dt><dd class="display text-5xl" data-count="@Model.Followers">@Model.Followers</dd></div>
        <div class="border-b-2 border-ink p-4"><dt class="eyebrow text-xs">Monthly listeners</dt><dd class="display text-5xl" data-count="@Model.MonthlyListeners">@Model.MonthlyListeners</dd></div>
        <div class="border-r-2 border-ink p-4"><dt class="eyebrow text-xs">Total plays</dt><dd class="display text-5xl">@Fmt.Count(Model.TotalPlays)</dd></div>
        <div class="p-4"><dt class="eyebrow text-xs">Tracks</dt><dd class="display text-5xl" data-count="@Model.TrackCount">@Model.TrackCount</dd></div>
      </dl>
    </div>
  </div>
</section>

<section class="section">
  @Html.Partial("_PubSectionHead", new PubSectionHeadVm("Popular", "Top tracks.", null, null))
  <div class="mt-8">@Html.Partial("_TrackList", new TrackListVm { Tracks = Model.TopTracks, ShowAlbum = true, Empty = "No published tracks yet." })</div>
</section>

@if (Model.Albums.Any())
{
<section class="border-y-2 border-ink bg-mint">
  <div class="section">
    @Html.Partial("_PubSectionHead", new PubSectionHeadVm("Discography", "Albums & EPs.", null, null))
    <div class="mt-10 grid grid-cols-2 gap-5 md:grid-cols-4">@foreach (var al in Model.Albums) { <div data-reveal>@Html.Partial("_AlbumCard", al)</div> }</div>
  </div>
</section>
}

@if (Model.Similar.Any())
{
<section class="section">
  @Html.Partial("_PubSectionHead", new PubSectionHeadVm("Fans also like", "Same wavelength.", null, null))
  <div class="mt-10 grid grid-cols-2 gap-5 md:grid-cols-4">@foreach (var s in Model.Similar) { <div data-reveal data-tilt="5">@Html.Partial("_ArtistCard", s)</div> }</div>
</section>
}
