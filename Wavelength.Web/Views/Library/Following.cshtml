@model FollowingVm
@using Wavelength.Web.Infrastructure
@{
    ViewBag.Title = "Following";
    ViewBag.Nav = "library";
}
@Html.Partial("~/Views/Library/_LibraryHero.cshtml", new LibraryHeroVm { Active = "following", Sticker = "Your people", StickerColor = "bg-cobalt text-paper", Title = "Your", Highlight = "crew.", Text = "Artists and listeners you follow, and the ones who follow you back." })

<section class="section !pt-12">
  <div class="flex flex-wrap gap-3">
    <a href="/following" class="chip @(Model.Tab == "following" ? "chip-on" : "chip-off")">Following <span class="ml-2 opacity-70">@Model.FollowingCount</span></a>
    <a href="/following?tab=followers" class="chip @(Model.Tab == "followers" ? "chip-on" : "chip-off")">Followers <span class="ml-2 opacity-70">@Model.FollowersCount</span></a>
  </div>

  <div class="mt-8">
    @if (!Model.People.Any())
    {
      @Ui.EmptyState(Model.Tab == "following" ? "You are not following anyone yet. Find artists on the Explore page." : "No followers yet. Share a playlist and they will come.")
      if (Model.Tab == "following") { <div class="mt-6 text-center"><a href="/explore" class="btn-volt">Explore artists →</a></div> }
    }
    else
    {
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        @{ var i = 0; }
        @foreach (var p in Model.People)
        {
          <div class="brut wiggle flex items-center gap-4 bg-white p-4" data-reveal="@(i++ % 6 * 60)">
            <a href="@p.Link" class="shrink-0">@Html.Avatar(p.AvatarUrl, p.Name, "h-16 w-16 text-3xl")</a>
            <div class="min-w-0 flex-1">
              <a href="@p.Link" class="display block truncate text-2xl hover:underline">@p.Name@(p.Verified ? " ✓" : "")</a>
              <p class="truncate font-mono text-xs uppercase">@(p.ArtistId != null ? "Artist" : "@" + p.Username) · @Fmt.Count(p.Followers) followers</p>
              <p class="font-mono text-[11px] text-ink/60">since @p.Since.ToString("d MMM yyyy", System.Globalization.CultureInfo.InvariantCulture)</p>
            </div>
            <form method="post" action="/follow/@p.UserId">
              @Html.AntiForgeryToken()
              <input type="hidden" name="returnUrl" value="@(Model.Tab == "followers" ? "/following?tab=followers" : "/following")">
              @if (p.IFollow)
              {
                <button type="submit" class="chip chip-on !px-3 hover:!bg-flame" title="Unfollow">Following</button>
              }
              else
              {
                <button type="submit" class="chip chip-off !px-3 hover:bg-volt">+ Follow</button>
              }
            </form>
          </div>
        }
      </div>
    }
  </div>
</section>
