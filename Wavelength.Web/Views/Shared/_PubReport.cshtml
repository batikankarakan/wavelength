@model PubReportVm
@* Small "report" disclosure with a reason form. Field is trackId, commentId or reportedUserId. *@
@if (Request.IsAuthenticated)
{
    <details class="group relative">
        <summary class="cursor-pointer list-none font-mono text-xs font-bold uppercase text-ink/60 hover:text-flame">⚑ @Model.Label</summary>
        @using (Html.BeginForm("Report", "Social", FormMethod.Post, new { @class = "brut absolute right-0 z-30 mt-2 w-72 space-y-3 bg-paper p-4 text-ink" }))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="@Model.Field" value="@Model.Id">
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl">
            <label class="label !text-xs" for="r-@Model.Field-@Model.Id">What's wrong?</label>
            <textarea id="r-@Model.Field-@Model.Id" name="reason" required minlength="5" maxlength="300" rows="3" class="field !py-2 text-sm" placeholder="Spam, stolen music, abuse…"></textarea>
            <button class="btn-flame btn-sm w-full">Send report</button>
        }
    </details>
}
