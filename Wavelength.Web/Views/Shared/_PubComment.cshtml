@model PubCommentVm
@using Wavelength.Web.Infrastructure
@{ var c = Model.Comment; }
<div class="border-2 border-ink bg-white p-4 @(c.IsArtist ? "shadow-brut bg-mint" : "shadow-brut-sm")">
    <div class="flex items-center gap-3">
        <a href="/users/@c.Username">@Html.Avatar(c.AvatarUrl, c.Name, "h-10 w-10 text-lg")</a>
        <div class="min-w-0 flex-1">
            <a href="/users/@c.Username" class="font-mono text-sm font-bold hover:underline">@c.Name</a>
            @if (c.IsArtist) { <span class="status ml-1 bg-volt">Artist</span> }
            <p class="font-mono text-xs text-ink/60">@Fmt.Ago(c.CreatedAt)</p>
        </div>
        @if (User.UserId() != c.UserId) { @Html.Partial("_PubReport", new PubReportVm("commentId", c.Id, "Report", Model.ReturnUrl + "#comments")) }
    </div>
    <p class="mt-3 whitespace-pre-line break-words">@c.Body</p>
</div>
