@model GenreItem
<a href="/genres/@Model.Slug" class="brut wiggle relative block overflow-hidden p-5" style="background:@Model.Color;color:@Fmt.On(Model.Color)">
    <span class="halftone absolute inset-0 opacity-20"></span>
    <span class="relative block font-mono text-xs font-bold uppercase">@Model.TrackCount tracks</span>
    <span class="display relative mt-8 block break-words text-[clamp(1.6rem,7vw,2.25rem)] md:text-5xl">@Model.Name</span>
</a>
