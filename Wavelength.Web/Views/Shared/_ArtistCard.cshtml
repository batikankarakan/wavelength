@model ArtistItem
@using Wavelength.Web.Infrastructure
<a href="/artists/@Model.Id" class="brut wiggle group block bg-white p-4 text-center">
    @Html.Cover(new CoverVm { Url = Model.AvatarUrl, Color = Fmt.ColorFor(Model.Id), Label = Model.StageName, Round = true })
    <p class="display mt-4 truncate text-2xl">@Model.StageName@(Model.Verified ? " ✓" : "")</p>
    <p class="truncate font-mono text-xs uppercase">@Fmt.Count(Model.Followers) followers · @Fmt.Count(Model.Plays) plays</p>
</a>
