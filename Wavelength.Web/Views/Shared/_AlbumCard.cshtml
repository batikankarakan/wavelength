@model AlbumItem
@using Wavelength.Web.Infrastructure
<a href="/albums/@Model.Id" class="brut wiggle group block bg-white p-3">
    @Html.Cover(new CoverVm { Url = Model.CoverUrl, Color = Fmt.ColorFor(Model.Id + 1), Label = Model.Title })
    <p class="display mt-3 truncate text-2xl">@Model.Title</p>
    <p class="truncate font-mono text-xs uppercase">@Model.Artist · @Model.Type · @Model.ReleaseDate.Year</p>
</a>
