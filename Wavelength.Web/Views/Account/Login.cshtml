@model Wavelength.Web.Controllers.LoginForm
@using Wavelength.Web.Infrastructure
@{ ViewBag.Title = "Log in"; ViewBag.HideFooter = true; }
<section class="grid min-h-screen border-b-2 border-ink pt-[66px] lg:grid-cols-2">
    @Html.Partial("_AuthAside", new AuthAsideVm { Sticker = "Welcome back", Line1 = "Press", Highlight = "play", Line3 = "again.", Text = "Your library, playlists and history are right where you left them.", Color = "bg-cobalt text-paper" })
    <div class="flex items-center justify-center px-6 py-16">
        <div class="w-full max-w-md">
            @Html.Sticker("Log in")
            <h1 data-hop class="display mt-6 text-7xl">Log in.</h1>
            <p class="mt-3 font-mono text-sm">New here? @Html.ActionLink("Create an account →", "Register", "Account", null, new { @class = "font-bold underline decoration-2 hover:bg-volt" })</p>
            @using (Html.BeginForm("Login", "Account", FormMethod.Post, new { @class = "brut mt-8 space-y-5 bg-white p-6 md:p-8", novalidate = "novalidate" }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "font-mono text-sm font-bold text-flame" })
                @Html.HiddenFor(m => m.ReturnUrl)
                @Html.BrutField(m => m.Email, "Email", "email", "you@example.com", "email")
                <div>
                    <div class="flex items-center justify-between">
                        @Html.LabelFor(m => m.Password, "Password", new { @class = "label" })
                        @Html.ActionLink("Forgot?", "Forgot", "Account", null, new { @class = "mb-2 font-mono text-xs font-bold underline hover:bg-volt" })
                    </div>
                    @Html.PasswordFor(m => m.Password, new { @class = "field", placeholder = "••••••••", autocomplete = "current-password" })
                    @Html.ValidationMessageFor(m => m.Password, null, new { @class = "err block" })
                </div>
                <label class="flex items-center gap-3 font-mono text-sm">@Html.CheckBoxFor(m => m.Remember, new { @class = "tick" }) Keep me logged in</label>
                <button type="submit" class="btn-volt w-full">Log in →</button>
            }
            <details class="mt-6 border-2 border-dashed border-ink p-4 font-mono text-xs">
                <summary class="cursor-pointer font-bold uppercase">Demo accounts</summary>
                <p class="mt-3">Password for all: <b>@WavelengthInitializer.DemoPassword</b></p>
                <ul class="mt-2 space-y-1">
                    <li>admin@@wavelength.app · admin</li>
                    <li>mod@@wavelength.app · moderator</li>
                    <li>kora@@wavelength.app · artist</li>
                    <li>listener@@wavelength.app · listener</li>
                </ul>
            </details>
        </div>
    </div>
</section>
