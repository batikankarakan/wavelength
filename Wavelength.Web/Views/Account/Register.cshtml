@model Wavelength.Web.Controllers.RegisterForm
@using Wavelength.Web.Infrastructure
@{ ViewBag.Title = "Sign up"; ViewBag.HideFooter = true; }
<section class="grid min-h-screen border-b-2 border-ink pt-[66px] lg:grid-cols-2">
    @Html.Partial("_AuthAside", new AuthAsideVm { Sticker = "Free forever*", Line1 = "Share.", Highlight = "Save.", Line3 = "Play.", Text = "Make an account to like tracks, build playlists, follow artists and keep your history. Artists get a studio to upload music.", Color = "bg-flame text-paper" })
    <div class="flex items-center justify-center px-6 py-16">
        <div class="w-full max-w-lg">
            @Html.Sticker("Sign up", "bg-mint")
            <h1 data-hop class="display mt-6 text-7xl">Join the crew.</h1>
            <p class="mt-3 font-mono text-sm">Already have an account? @Html.ActionLink("Log in →", "Login", "Account", null, new { @class = "font-bold underline decoration-2 hover:bg-volt" })</p>
            @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { @class = "brut mt-8 space-y-5 bg-white p-6 md:p-8", id = "register-form" }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "font-mono text-sm font-bold text-flame" })
                <div class="grid gap-5 md:grid-cols-2">
                    @Html.BrutField(m => m.DisplayName, "Name", placeholder: "Your name", autocomplete: "name")
                    @Html.BrutField(m => m.Username, "Username", placeholder: "username", autocomplete: "username")
                </div>
                @Html.BrutField(m => m.Email, "Email", "email", "you@example.com", "email")
                <div class="grid gap-5 md:grid-cols-2">
                    @Html.BrutField(m => m.Password, "Password", "password", "8+ characters", "new-password")
                    @Html.BrutField(m => m.ConfirmPassword, "Repeat", "password", "again", "new-password")
                </div>
                <div>
                    <p class="label">I am a</p>
                    <div class="grid grid-cols-2 gap-3" id="role-picker">
                        <label class="role-option flex cursor-pointer items-center gap-3 border-2 border-ink p-4 transition">
                            @Html.RadioButtonFor(m => m.AsArtist, false, new { @class = "tick", id = "as-listener" }) <span class="display text-2xl">Listener</span>
                        </label>
                        <label class="role-option flex cursor-pointer items-center gap-3 border-2 border-ink p-4 transition">
                            @Html.RadioButtonFor(m => m.AsArtist, true, new { @class = "tick", id = "as-artist" }) <span class="display text-2xl">Artist</span>
                        </label>
                    </div>
                </div>
                <div id="stage-name" class="@(Model.AsArtist ? "" : "hidden")">
                    @Html.BrutField(m => m.StageName, "Stage name", placeholder: "How fans will see you")
                    <p class="hint">You get an artist studio to upload tracks. Every upload is reviewed before it goes live.</p>
                </div>
                <label class="flex items-start gap-3 font-mono text-sm">@Html.CheckBoxFor(m => m.AcceptTerms, new { @class = "tick mt-0.5" }) <span>I accept the <a href="/terms" target="_blank" class="font-bold underline">terms and upload rules</a>.</span></label>
                @Html.ValidationMessageFor(m => m.AcceptTerms, null, new { @class = "err block" })
                <button type="submit" class="btn-volt w-full">Create account →</button>
            }
        </div>
    </div>
</section>
@section Scripts {
<script>
    // jQuery: show the stage name field and highlight the chosen role
    $(function () {
        function sync() {
            var artist = $('#as-artist').is(':checked');
            $('#stage-name').toggleClass('hidden', !artist);
            $('.role-option').each(function () {
                var on = $(this).find('input').is(':checked');
                $(this).toggleClass('bg-volt shadow-brut-sm', on).toggleClass('bg-paper', !on);
            });
        }
        $('#role-picker input').on('change', sync);
        sync();
    });
</script>
}
