@model TrackFormVm
@using Wavelength.Web.Infrastructure
@{
    var f = Model.Form;
    var isNew = Model.IsNew;
    ViewBag.StudioTitle = isNew ? "Upload." : "Edit track.";
    ViewBag.StudioAccent = isNew ? "bg-volt" : "bg-mint";
    ViewBag.StudioLead = isNew
        ? "Fill in the details, pick up to three genres and send it to the review queue. A moderator listens to every track before it goes live."
        : null;
    var s = Model.Status;
    string explain;
    if (s == TrackStatus.Draft) { explain = "Only you can see this track. Submit it when it's ready."; }
    else if (s == TrackStatus.Pending) { explain = "Waiting in the review queue. You can still fix typos while you wait."; }
    else if (s == TrackStatus.Published) { explain = "Live in the public catalog. Replacing the audio sends it back to review."; }
    else if (s == TrackStatus.Rejected) { explain = "A moderator declined this track. Read the reason, fix it and resubmit."; }
    else if (s == TrackStatus.Hidden) { explain = "Hidden after a report. A moderator can restore it."; }
    else { explain = ""; }
    var flow = new[] { TrackStatus.Draft, TrackStatus.Pending, TrackStatus.Published };
    var genreIds = f.GenreIds ?? new List<int>();
    var albums = new SelectList(Model.Albums, "Id", "Title", f.AlbumId);
    var formAttrs = new { enctype = "multipart/form-data", @class = "brut space-y-7 bg-white p-6 md:p-10", data_reveal = "" };
}
@Html.Partial("_StudioNav", Model.Header)

<section class="section !pt-14">
    <div class="grid gap-10 lg:grid-cols-[1.6fr_1fr]">
        @using (isNew ? Html.BeginForm("Upload", "Studio", FormMethod.Post, formAttrs) : Html.BeginForm("Edit", "Studio", new { id = f.Id }, FormMethod.Post, formAttrs))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "font-mono text-sm font-bold text-flame" })

            <div>
                @Html.LabelFor(m => m.Form.Title, "Title", new { @class = "label" })
                @Html.TextBoxFor(m => m.Form.Title, new { @class = "field text-lg", maxlength = "120", placeholder = "Name of the track" })
                @Html.ValidationMessageFor(m => m.Form.Title, null, new { @class = "err block" })
            </div>

            <div data-vue="audio-picker" data-props="@Fmt.Json(new { duration = f.DurationSec, hasCurrent = !isNew })">
                <p class="label">Audio file @(isNew ? "" : "· optional, replaces the current file")</p>
                <label for="Form_Audio" class="flex cursor-pointer items-center gap-4 border-2 border-dashed border-ink bg-paper p-5 transition hover:bg-volt/40">
                    <span class="flex h-14 w-14 shrink-0 items-center justify-center border-2 border-ink bg-volt text-2xl shadow-brut-sm">♪</span>
                    <span class="min-w-0">
                        <span class="display block truncate text-2xl">{{ name || (hasCurrent ? 'Keep current audio' : 'Choose an audio file') }}</span>
                        <span class="block font-mono text-xs">MP3, WAV, OGG or M4A · up to 20 MB</span>
                    </span>
                </label>
                <input id="Form_Audio" name="Form.Audio" type="file" accept=".mp3,.wav,.ogg,.m4a,audio/*" class="sr-only" v-on:change="pick">
                <input type="hidden" name="Form.DurationSec" :value="dur">
                <p v-if="reading" class="hint">Reading the file…</p>
                <p v-else-if="dur" class="hint">Length: <b>{{ fmt(dur) }}</b> (detected automatically)</p>
                <p v-if="err" class="err">! {{ err }}</p>
            </div>
            @Html.ValidationMessage("Form.Audio", null, new { @class = "err block" })

            <div>
                <p class="label">Genres · pick 1 to 3</p>
                <div class="flex flex-wrap gap-3" data-genres>
                    @foreach (var g in Model.Genres)
                    {
                        <label class="cursor-pointer">
                            <input type="checkbox" name="Form.GenreIds" value="@g.Id" class="peer sr-only" @(genreIds.Contains(g.Id) ? "checked" : "")>
                            <span class="chip chip-off peer-checked:bg-ink peer-checked:text-paper peer-checked:shadow-brut-sm peer-focus-visible:ring-4 peer-focus-visible:ring-cobalt"><i class="mr-2 inline-block h-3 w-3 border-2 border-ink" style="background:@g.Color"></i>@g.Name</span>
                        </label>
                    }
                </div>
                @Html.ValidationMessage("Form.GenreIds", null, new { @class = "err block" })
            </div>

            <div class="grid gap-6 md:grid-cols-2">
                <div>
                    @Html.LabelFor(m => m.Form.AlbumId, "Album", new { @class = "label" })
                    @Html.DropDownListFor(m => m.Form.AlbumId, albums, "No album (single)", new { @class = "field" })
                    <p class="hint">Create albums in the @Html.ActionLink("Albums", "Albums", "Studio", null, new { @class = "underline" }) tab.</p>
                    @Html.ValidationMessageFor(m => m.Form.AlbumId, null, new { @class = "err block" })
                </div>
                <div data-vue="cover-picker" data-props="@Fmt.Json(new { url = Model.CoverUrl })">
                    <p class="label">Cover image · optional</p>
                    <div class="flex items-center gap-4">
                        <label for="Form_Cover" class="relative flex h-24 w-24 shrink-0 cursor-pointer items-center justify-center overflow-hidden border-2 border-ink bg-volt shadow-brut-sm">
                            <img v-if="preview && !remove" :src="preview" alt="" class="absolute inset-0 h-full w-full object-cover">
                            <span v-else class="display text-4xl">+</span>
                        </label>
                        <div class="space-y-2">
                            <label for="Form_Cover" class="btn-paper btn-sm cursor-pointer">Choose image</label>
                            <label v-if="url && !picked" class="flex items-center gap-2 font-mono text-xs"><input type="checkbox" name="Form.RemoveCover" value="true" class="tick" v-model="remove"> Remove cover</label>
                        </div>
                    </div>
                    <input id="Form_Cover" name="Form.Cover" type="file" accept=".jpg,.jpeg,.png,.webp,.gif,image/*" class="sr-only" v-on:change="pick">
                    <p class="hint">JPG, PNG, WEBP or GIF · up to 4 MB · square looks best.</p>
                </div>
            </div>
            @Html.ValidationMessage("Form.Cover", null, new { @class = "err block" })

            <div>
                @Html.LabelFor(m => m.Form.Lyrics, "Lyrics · optional", new { @class = "label" })
                @Html.TextAreaFor(m => m.Form.Lyrics, new { rows = "8", maxlength = "8000", @class = "field resize-y", placeholder = "Paste the lyrics here" })
                @Html.ValidationMessageFor(m => m.Form.Lyrics, null, new { @class = "err block" })
            </div>

            <div class="flex flex-col gap-4 border-t-2 border-ink pt-7 sm:flex-row">
                @if (isNew || s == TrackStatus.Draft || s == TrackStatus.Rejected)
                {
                    <button type="submit" name="intent" value="draft" class="btn-paper flex-1">@(s == TrackStatus.Rejected ? "Save as draft" : "Save draft")</button>
                    <button type="submit" name="intent" value="submit" class="btn-volt flex-1">@(s == TrackStatus.Rejected ? "Resubmit for review →" : "Submit for review →")</button>
                }
                else
                {
                    <button type="submit" name="intent" value="save" class="btn-volt flex-1">Save changes →</button>
                }
            </div>
        }

        <aside class="space-y-8">
            @if (!isNew)
            {
                <div data-reveal="80" class="brut bg-paper p-6" data-tracklist>
                    <p class="eyebrow">Status</p>
                    <div class="mt-3 flex items-center gap-3">
                        <span class="status status-@s text-sm">@s</span>
                        <button type="button" data-play="@f.Id" class="ml-auto flex h-11 items-center gap-2 border-2 border-ink bg-volt px-4 font-mono text-xs font-bold uppercase shadow-brut-sm" aria-label="Preview"><span data-play-icon>▶</span> Preview</button>
                    </div>
                    <p class="mt-4 font-medium">@explain</p>
                    @if (Model.RejectionReason != null)
                    {
                        <div class="mt-5 -rotate-1 border-2 border-ink bg-flame p-4 text-paper shadow-brut-sm">
                            <p class="eyebrow text-xs">Moderator feedback</p>
                            <p class="mt-2 font-mono text-sm font-bold">“@Model.RejectionReason”</p>
                        </div>
                    }
                    @if (s == TrackStatus.Published)
                    {
                        <a href="/tracks/@f.Id" class="btn-paper btn-sm mt-5 w-full">Open public page ↗</a>
                    }
                </div>
            }

            <div data-reveal="120" class="brut bg-ink p-6 text-paper">
                <p class="eyebrow text-volt">How review works</p>
                <ol class="mt-5 space-y-3">
                    @for (var i = 0; i < flow.Length; i++)
                    {
                        var on = !isNew && s == flow[i];
                        <li class="flex items-center gap-3">
                            <span class="display flex h-10 w-10 items-center justify-center border-2 border-paper text-xl @(on ? "bg-volt text-ink" : "")">@(i + 1)</span>
                            <span class="font-mono text-sm font-bold uppercase @(on ? "text-volt" : "")">@flow[i]</span>
                        </li>
                    }
                </ol>
                <p class="mt-5 font-mono text-xs text-paper/70">Draft → submit → a moderator listens and approves or rejects with a reason. Rejected tracks can be edited and resubmitted.</p>
            </div>

            @if (!isNew && (s == TrackStatus.Draft || s == TrackStatus.Rejected || s == TrackStatus.Published))
            {
                using (Html.BeginForm("Delete", "Studio", new { id = f.Id }, FormMethod.Post, new { data_confirm = "Delete this track for good? Plays, likes and comments go with it.", data_reveal = "160", @class = "border-2 border-dashed border-flame p-6" }))
                {
                    @Html.AntiForgeryToken()
                    <p class="eyebrow text-flame">Danger zone</p>
                    <p class="mt-2 font-mono text-sm">Deleting removes the audio, likes, comments and history of this track.</p>
                    <button type="submit" class="btn-flame btn-sm mt-4">Delete track</button>
                }
            }
        </aside>
    </div>
</section>

@section Scripts {
<script>
    WL.island('audio-picker', {
        props: ['duration', 'hasCurrent'],
        data() { return { dur: this.$props.duration || 0, name: '', reading: false, err: '' }; },
        methods: {
            fmt: (s) => WL.fmt(s),
            pick(e) {
                const file = e.target.files[0];
                this.err = ''; this.name = file ? file.name : '';
                if (!file) { this.dur = this.$props.duration || 0; return; }
                if (file.size > 20 * 1024 * 1024) { this.err = 'Audio file must be 20 MB or smaller.'; }
                this.reading = true;
                const url = URL.createObjectURL(file);
                const a = new Audio();
                a.preload = 'metadata';
                a.onloadedmetadata = () => { this.dur = Math.max(1, Math.round(a.duration)); this.reading = false; URL.revokeObjectURL(url); };
                a.onerror = () => { this.dur = 0; this.reading = false; this.err = 'This file could not be read as audio.'; URL.revokeObjectURL(url); };
                a.src = url;
            },
        },
    });
    WL.island('cover-picker', {
        props: ['url'],
        data() { return { preview: this.$props.url, picked: false, remove: false }; },
        methods: {
            pick(e) {
                const file = e.target.files[0];
                if (!file) return;
                this.picked = true; this.remove = false;
                this.preview = URL.createObjectURL(file);
            },
        },
    });
    // jQuery: at most three genres
    $('[data-genres]').on('change', 'input', function () {
        if ($('[data-genres] input:checked').length > 3) { this.checked = false; WL.toast('Pick at most three genres.', 'error'); }
    });
</script>
}
