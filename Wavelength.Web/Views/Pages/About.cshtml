@using Wavelength.Web.Infrastructure
@{
    ViewBag.Title = "About";
    var team = new[]
    {
        Tuple.Create("Emre Men", "Group Leader · Coordination & docs", "#FFE500"),
        Tuple.Create("İbrahim Mutlu", "Database design & ER diagram", "#2B3BFF"),
        Tuple.Create("Hüseyin Yiğit Efil", "Page list & UML diagrams", "#FF4A1C"),
        Tuple.Create("Batıkan Karakan", "Landing page, tools & timeline", "#8CF5C0"),
    };
    var phases = new[]
    {
        Tuple.Create("14 Oct – 21 Oct", "Analysis & landing page", "Tables, pages, UML, ER, tools, timeline and the three-page static site."),
        Tuple.Create("22 Oct – 4 Nov", "Backend & database", "Project skeleton, SQL Server connection, all 19 tables and seed data."),
        Tuple.Create("29 Oct – 11 Nov", "Accounts & roles", "Register, login, logout, password reset, roles and profile settings."),
        Tuple.Create("5 Nov – 25 Nov", "Catalog & approval flow", "Uploads, tracks, albums, genres, the review queue and the status flow."),
        Tuple.Create("19 Nov – 16 Dec", "Library & player", "Playlists, likes, saved items, listening history and real audio playback."),
        Tuple.Create("10 Dec – 6 Jan", "Social & notifications", "Follows, comments, share links, notifications and weekly charts."),
        Tuple.Create("17 Dec – 10 Jan", "Admin & moderation", "Dashboard, users, reports, genres, messages and the audit log."),
        Tuple.Create("5 Jan – 20 Jan", "Testing & polish", "Bug fixing, responsive checks and the final documentation."),
    };
    var faq = new[]
    {
        new { q = "What is Wavelength?", a = "A platform where you can share, save and listen to music in one place. Think of it as your personal radio, built with a community." },
        new { q = "Is it free?", a = "Yes. This is a university project, so everything is free." },
        new { q = "Can I upload my own music?", a = "Yes. Sign up as an artist and you get a studio to upload tracks and albums. Every upload is checked by a moderator before it goes live." },
        new { q = "Why was my track rejected?", a = "The moderator always writes a reason. You will find it in your notifications and on the track's edit page. Fix it and submit again." },
        new { q = "Who built this?", a = "A team of four students for the Web Programming course, using ASP.NET MVC, Entity Framework, SQL Server, Tailwind and Vue." },
    };
    string[] numColors = { "text-flame", "text-cobalt", "text-ink", "text-flame" };
}
<section class="relative overflow-hidden border-b-2 border-ink pt-32">
  <div class="mx-auto max-w-7xl px-6 pb-20">
    <span class="sticker bg-volt">About us</span>
    <h1 data-hop class="display mt-8 text-[clamp(4rem,12vw,11rem)]">Music is <span class="hop-ink inline-block rotate-1 border-2 border-ink bg-flame px-4 text-paper shadow-brut">better</span> together.</h1>
    <p class="mt-8 max-w-2xl text-xl font-medium">Wavelength started with one annoying question: why is sharing a great song still so complicated? Four students decided to fix it.</p>
  </div>
</section>

<section class="section">
  <div class="grid gap-8 md:grid-cols-3">
    <div data-reveal class="brut bg-volt p-8 md:col-span-2 md:p-12">
      <span class="eyebrow">/ Mission</span>
      <p class="display mt-4 text-4xl md:text-6xl">One place to share, save and play the music you love. No noise in between.</p>
    </div>
    <div data-reveal="120" class="brut flex flex-col justify-between bg-cobalt p-8 text-paper">
      <p class="display text-[10rem] leading-none">4</p>
      <p class="font-mono">students. one shared playlist. endless coffee.</p>
    </div>
  </div>
</section>

<section class="border-y-2 border-ink bg-mint">
  <div class="section">
    <h2 data-hop data-reveal class="display text-6xl md:text-8xl">The crew.</h2>
    <div class="mt-14 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      @for (var i = 0; i < team.Length; i++)
      {
        var m = team[i];
        <article data-reveal="@(i * 100)" data-tilt="7" class="brut wiggle bg-paper p-4">
          <div class="relative flex aspect-square items-center justify-center overflow-hidden border-2 border-ink" style="background:@m.Item3;color:@Fmt.On(m.Item3)">
            <div class="halftone absolute inset-0 opacity-20"></div>
            <span class="display relative text-[9rem] leading-none">@m.Item1.Split(' ').Last()[0]</span>
          </div>
          <h3 class="display mt-4 text-3xl">@m.Item1</h3>
          <p class="font-mono text-xs uppercase">@m.Item2</p>
        </article>
      }
    </div>
  </div>
</section>

<section class="section">
  <h2 data-hop data-reveal class="display text-6xl md:text-8xl">Where we're <span class="text-cobalt">headed.</span></h2>
  <div class="mt-14 grid gap-6 md:grid-cols-2">
    @for (var i = 0; i < phases.Length; i++)
    {
      var t = phases[i];
      <div data-reveal="@(i % 2 * 80)" class="brut flex gap-6 bg-white p-6">
        <p class="display text-7xl leading-none @numColors[i % 4]">@(i + 1)</p>
        <div>
          <p class="eyebrow">Phase @(i + 1) · @t.Item1</p>
          <h3 class="display mt-1 text-3xl">@t.Item2</h3>
          <p class="mt-2 font-medium">@t.Item3</p>
        </div>
      </div>
    }
  </div>
</section>

<section class="section">
  <div class="mx-auto max-w-3xl">
    <h2 data-hop data-reveal class="display text-6xl md:text-7xl">Questions?</h2>
    <div class="mt-10 space-y-4" data-vue="faq" data-props="@Fmt.Json(new { faq })" v-cloak>
      <div v-for="(f, i) in faq" :key="f.q" class="border-2 border-ink bg-white" :class="openFaq === i ? 'shadow-brut' : ''">
        <button type="button" class="flex w-full items-center justify-between px-6 py-5 text-left font-display text-2xl uppercase" v-on:click="openFaq = openFaq === i ? -1 : i" :aria-expanded="openFaq === i">
          {{ f.q }}
          <span class="text-4xl transition-transform duration-200" :class="openFaq === i ? 'rotate-45' : ''">+</span>
        </button>
        <div class="grid transition-all duration-300" :class="openFaq === i ? 'grid-rows-[1fr]' : 'grid-rows-[0fr]'">
          <p class="overflow-hidden px-6 font-medium" :class="openFaq === i ? 'pb-5' : ''">{{ f.a }}</p>
        </div>
      </div>
    </div>
  </div>
</section>

@section Scripts {
<script>
  WL.island('faq', { props: ['faq'], data() { return { openFaq: 0 }; } });
</script>
}
