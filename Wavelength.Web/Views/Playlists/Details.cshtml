@model PlaylistPageVm
@using Wavelength.Web.Infrastructure
@{
    var p = Model.Playlist;
    var here = "/playlists/" + p.Id;
    var signedIn = Request.IsAuthenticated;
}
<section class="relative overflow-hidden border-b-2 border-ink page-top">
  <div class="halftone absolute -right-20 top-20 hidden h-[26rem] w-[26rem] opacity-20 lg:block"></div>
  <div class="relative mx-auto grid max-w-7xl items-end gap-10 px-6 pb-16 md:grid-cols-[22rem_1fr]">
    <div data-tilt="6" class="relative">
      <span class="sticker absolute -left-4 -top-4 z-10 @(p.IsPublic ? "bg-mint" : "bg-ink text-paper")">@(p.IsPublic ? "Public" : "🔒 Private")</span>
      <div class="brut bg-white p-3">@Html.Cover(new CoverVm { Url = p.CoverUrl, Color = Fmt.ColorFor(p.Id + 2), Label = p.Title })</div>
    </div>
    <div>
      <p class="eyebrow">/ Playlist</p>
      <h1 data-hop class="display mt-3 text-[clamp(3.5rem,9vw,8rem)]">@p.Title</h1>
      @if (!string.IsNullOrWhiteSpace(p.Description)) { <p class="mt-4 max-w-2xl text-xl font-medium">@p.Description</p> }
      <div class="mt-4 flex flex-wrap items-center gap-3 font-mono text-sm">
        <a href="/users/@p.OwnerUsername" class="inline-flex items-center gap-2 font-bold hover:underline">@Html.Avatar(Model.OwnerAvatar, p.Owner, "h-8 w-8 text-sm") @p.Owner</a>
        <span>· @Model.Tracks.Count track@(Model.Tracks.Count == 1 ? "" : "s") · @PublicHelpers.TotalDuration(Model.Tracks) · @Model.Saves save@(Model.Saves == 1 ? "" : "s") · since @Model.CreatedAt.ToString("MMM yyyy")</span>
      </div>
      <div class="mt-8 flex flex-wrap gap-3">
        @if (Model.Tracks.Any()) { <button type="button" data-play-all="@string.Join(",", Model.Tracks.Select(t => t.Id))" class="btn-volt">▶ Play all</button> }
        @if (Model.IsOwner) { <a href="/playlists/@p.Id/edit" class="btn-ink">✎ Edit playlist</a> }
        else if (signedIn)
        {
          using (Html.BeginForm("Save", "Playlists", new { id = p.Id }, FormMethod.Post))
          {
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@here">
            <button class="@(Model.Saved ? "btn-ink" : "btn-paper")">@(Model.Saved ? "✓ Saved" : "＋ Save playlist")</button>
          }
        }
        else { <a href="/login?returnUrl=@Uri.EscapeDataString(here)" class="btn-paper">＋ Save playlist</a> }
      </div>
    </div>
  </div>
</section>
<section class="section">
  @Html.Partial("_TrackList", new TrackListVm { Tracks = Model.Tracks, ShowAlbum = true, Empty = Model.IsOwner ? "This playlist is empty. Add tracks from any track page or the playlist editor." : "This playlist is empty." })
</section>
