@model AdminMessagesVm
@using Wavelength.Web.Infrastructure
@{
    ViewBag.Title = "Contact inbox";
    var total = Model.Counts.Values.Sum();
}
@Html.Partial("_AdminNav", new AdminNavVm { Active = "messages", Title = "Inbox.", Sub = "Messages sent from the contact page. Opening a new message marks it as read." })

<section class="section !pt-12">
    <div class="flex flex-wrap gap-2 border-b-2 border-ink">
        <a href="/admin/messages" class="tab @(Model.Status == null ? "tab-on" : "tab-off")">All (@total)</a>
        @foreach (var s in new[] { "new", "read", "replied" })
        {
            <a href="/admin/messages?status=@s" class="tab @(Model.Status == s ? "tab-on" : "tab-off")">@s (@AdminUi.Get(Model.Counts, s))</a>
        }
    </div>

    <div class="mt-8 grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.3fr)]">
        <div>
            @if (!Model.Messages.Any())
            {
                @Ui.EmptyState("No messages here.")
            }
            else
            {
                <ul class="brut bg-white">
                    @foreach (var m in Model.Messages)
                    {
                        var active = Model.Open != null && Model.Open.Id == m.Id;
                        <li class="border-b-2 border-ink last:border-b-0">
                            <a href="@Model.Url(m.Id)" class="block p-4 transition hover:bg-volt @(active ? "bg-volt" : "")">
                                <div class="flex items-center gap-2">
                                    @Html.StatusBadge(m.Status)
                                    <span class="status @AdminUi.TopicColor(m.Topic)">@m.Topic</span>
                                    <span class="ml-auto font-mono text-xs">@Fmt.Ago(m.CreatedAt)</span>
                                </div>
                                <p class="display mt-2 truncate text-2xl @(m.Status == "new" ? "" : "text-ink/70")">@m.Name</p>
                                <p class="truncate font-mono text-xs">@m.Message</p>
                            </a>
                        </li>
                    }
                </ul>
                @Html.Partial("_Pager", Model.Pager)
            }
        </div>

        <div>
            @if (Model.Open != null)
            {
                var o = Model.Open;
                <article class="brut sticky top-24 bg-white" data-reveal>
                    <header class="border-b-2 border-ink bg-ink p-6 text-paper">
                        <div class="flex flex-wrap items-center gap-2">
                            <span class="status status-@o.Status @(o.Status == "new" ? "" : "text-ink")">@o.Status</span>
                            <span class="status @AdminUi.TopicColor(o.Topic) @(o.Topic == "bug" || o.Topic == "collaboration" ? "" : "text-ink")">@o.Topic</span>
                            <span class="ml-auto font-mono text-xs text-paper/60">#@o.Id · @o.CreatedAt.ToString("d MMM yyyy, HH:mm") UTC</span>
                        </div>
                        <h2 class="display mt-4 text-5xl">@o.Name</h2>
                        <a href="mailto:@o.Email" class="font-mono text-sm text-volt underline">@o.Email</a>
                    </header>
                    <p class="whitespace-pre-line p-6 text-lg font-medium">@o.Message</p>
                    <footer class="flex flex-wrap items-center gap-3 border-t-2 border-ink bg-paper p-4">
                        <a href="mailto:@o.Email?subject=@Uri.EscapeDataString("Re: your message to Wavelength")" class="btn-volt btn-sm">✉ Reply by email</a>
                        @foreach (var s in new[] { "new", "read", "replied" }.Where(x => x != o.Status))
                        {
                            using (Html.BeginForm("MessageStatus", "Admin", new { id = o.Id }, FormMethod.Post, null))
                            {
                                @Html.AntiForgeryToken()
                                @* plain inputs: Html.Hidden("status") would reuse the page's ?status= value from ModelState *@
                                <input type="hidden" name="status" value="@s">
                                <input type="hidden" name="returnUrl" value="@Model.Url(o.Id)">
                                <button class="btn-paper btn-sm">Mark @s</button>
                            }
                        }
                    </footer>
                </article>
            }
            else
            {
                <div class="flex h-full min-h-64 items-center justify-center border-2 border-dashed border-ink p-10 text-center">
                    <div>
                        <p class="display text-5xl">Pick a message.</p>
                        <p class="mt-2 font-mono text-sm">Select a message on the left to read it.</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
