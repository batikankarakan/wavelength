@model PlaylistEditVm
@using Wavelength.Web.Infrastructure
@{
    var f = Model.Form;
    var isNew = f.Id == null;
    ViewBag.Title = isNew ? "New playlist" : "Edit " + f.Title;
    ViewBag.Nav = "library";
    var back = isNew ? "/library/playlists" : "/playlists/" + f.Id;
    object routeValues = isNew ? null : (object)new { id = f.Id };
}
<section class="relative overflow-hidden border-b-2 border-ink page-top">
  <div class="halftone absolute -right-16 top-16 hidden h-80 w-80 opacity-20 md:block"></div>
  <div class="relative mx-auto max-w-7xl px-6 pb-12">
    <a href="@back" class="font-mono text-sm font-bold underline decoration-2 hover:bg-volt">← Back</a>
    <div class="mt-6"><span class="sticker @(isNew ? "bg-mint" : "bg-volt")">@(isNew ? "Create" : "Edit") playlist</span></div>
    <h1 data-hop class="display mt-6 text-[clamp(3.5rem,9vw,8rem)]">@(isNew ? "Make a" : "Tune the") <span class="inline-block -rotate-2 border-2 border-ink bg-volt px-3 shadow-brut">mix.</span></h1>
  </div>
</section>

<section class="section !pt-12">
  @using (Html.BeginForm(isNew ? "Create" : "Update", "PlaylistsManage", routeValues, FormMethod.Post, new { enctype = "multipart/form-data", @class = "grid gap-10 lg:grid-cols-[1fr_1.4fr]" }))
  {
    @Html.AntiForgeryToken()
    @* details *@
    <div class="space-y-6">
      <div class="brut space-y-5 bg-white p-6 md:p-8">
        <p class="eyebrow">/ Details</p>
        @Html.ValidationSummary(true, "", new { @class = "font-mono text-sm font-bold text-flame" })
        <div>
          @Html.LabelFor(m => m.Form.Title, "Title", new { @class = "label" })
          @Html.TextBoxFor(m => m.Form.Title, new { @class = "field", placeholder = "Late night coding", maxlength = "100" })
          @Html.ValidationMessageFor(m => m.Form.Title, null, new { @class = "err block" })
        </div>
        <div>
          @Html.LabelFor(m => m.Form.Description, "Description", new { @class = "label" })
          @Html.TextAreaFor(m => m.Form.Description, new { rows = "4", maxlength = "300", @class = "field resize-none", placeholder = "What is this mix for?" })
          @Html.ValidationMessageFor(m => m.Form.Description, null, new { @class = "err block" })
        </div>
        <div>
          <p class="label">Who can see it</p>
          <div class="grid grid-cols-2 gap-3">
            <label class="flex cursor-pointer items-center gap-3 border-2 border-ink p-4 has-[:checked]:bg-volt has-[:checked]:shadow-brut-sm">
              @Html.RadioButtonFor(m => m.Form.IsPublic, true, new { @class = "tick", id = "privacy-public" }) <span><span class="display block text-2xl">Public</span><span class="font-mono text-xs">anyone with the link</span></span>
            </label>
            <label class="flex cursor-pointer items-center gap-3 border-2 border-ink p-4 has-[:checked]:bg-volt has-[:checked]:shadow-brut-sm">
              @Html.RadioButtonFor(m => m.Form.IsPublic, false, new { @class = "tick", id = "privacy-private" }) <span><span class="display block text-2xl">Private</span><span class="font-mono text-xs">only you</span></span>
            </label>
          </div>
        </div>
      </div>

      <div class="brut space-y-4 bg-white p-6 md:p-8">
        <p class="eyebrow">/ Cover</p>
        <div class="flex items-center gap-5">
          <div class="w-28 shrink-0">
            @Html.Cover(new CoverVm { Url = f.CoverUrl, Color = Fmt.ColorFor((f.Id ?? 0) + 2), Label = string.IsNullOrEmpty(f.Title) ? "♪" : f.Title })
          </div>
          <div class="min-w-0 flex-1">
            <label for="cover" class="label">Upload image</label>
            <input id="cover" name="cover" type="file" accept="image/jpeg,image/png,image/webp,image/gif" class="block w-full font-mono text-xs file:mr-3 file:border-2 file:border-ink file:bg-volt file:px-3 file:py-2 file:font-mono file:font-bold file:uppercase">
            <p class="hint">JPG, PNG, WEBP or GIF · max 4 MB. Leave empty to keep the current one.</p>
            @Html.ValidationMessage("cover", new { @class = "err block" })
            @if (!string.IsNullOrEmpty(f.CoverUrl))
            {
              <label class="mt-3 flex items-center gap-2 font-mono text-sm"><input type="checkbox" name="Form.RemoveCover" value="true" class="tick"> Remove cover</label>
            }
          </div>
        </div>
      </div>

      <div class="flex flex-wrap gap-4">
        <button type="submit" class="btn-volt flex-1">@(isNew ? "Create playlist →" : "Save changes →")</button>
        <a href="@back" class="btn-paper">Cancel</a>
      </div>
    </div>

    @* tracks: Vue island (search, add, remove, reorder) *@
    <div data-vue="playlist-editor" data-props="@Fmt.Json(new { tracks = Model.Tracks })" v-cloak>
     <div>
      <div class="brut bg-mint p-6 md:p-8">
        <p class="eyebrow">/ Tracks · {{ list.length }} · {{ totalTime }}</p>
        <div class="relative mt-4">
          <input v-model="query" v-on:input="search" v-on:focus="search" type="search" class="field" placeholder="SEARCH TRACKS TO ADD" aria-label="Search tracks to add">
          <div v-if="open" class="absolute inset-x-0 top-full z-20 mt-2 max-h-80 overflow-y-auto border-2 border-ink bg-paper shadow-brut">
            <p v-if="loading" class="p-4 font-mono text-sm">Searching…</p>
            <p v-else-if="!results.length" class="p-4 font-mono text-sm">No tracks found.</p>
            <button v-for="r in results" :key="r.id" type="button" v-on:click="add(r)" :disabled="has(r.id)"
                    class="flex w-full items-center gap-3 border-b-2 border-ink p-3 text-left last:border-b-0 hover:bg-volt disabled:opacity-40">
              <span class="h-10 w-10 shrink-0 overflow-hidden border-2 border-ink" :style="{ background: r.color }"><img v-if="r.coverUrl" :src="r.coverUrl" alt="" class="h-full w-full object-cover"></span>
              <span class="min-w-0 flex-1"><span class="display block truncate text-xl">{{ r.title }}</span><span class="block truncate font-mono text-xs">{{ r.artist }}</span></span>
              <span class="font-mono text-sm font-bold">{{ has(r.id) ? '✓' : '+ Add' }}</span>
            </button>
            <button type="button" v-on:click="open = false" class="w-full border-t-2 border-ink bg-ink p-2 font-mono text-xs font-bold uppercase text-paper">Close</button>
          </div>
        </div>
      </div>

      <ol class="brut mt-6 bg-paper">
        <li v-if="!list.length" class="p-10 text-center">
          <p class="display text-4xl">Empty mix.</p>
          <p class="mt-2 font-mono text-sm">Search above to add your first track.</p>
        </li>
        <li v-for="(t, i) in list" :key="t.id" class="flex items-center gap-3 border-b-2 border-ink p-3 last:border-b-0 hover:bg-volt">
          <input type="hidden" name="Form.TrackIds" :value="t.id">
          <span class="display w-10 text-3xl text-ink/30">{{ String(i + 1).padStart(2, '0') }}</span>
          <span class="h-12 w-12 shrink-0 overflow-hidden border-2 border-ink" :style="{ background: t.color }"><img v-if="t.coverUrl" :src="t.coverUrl" alt="" class="h-full w-full object-cover"></span>
          <span class="min-w-0 flex-1"><span class="display block truncate text-xl md:text-2xl">{{ t.title }}</span><span class="block truncate font-mono text-xs">{{ t.artist }} · {{ fmt(t.durationSec) }}</span></span>
          <button type="button" v-on:click="move(i, -1)" :disabled="i === 0" class="icon-btn !h-9 !w-9 !text-base disabled:opacity-30" :aria-label="'Move ' + t.title + ' up'">↑</button>
          <button type="button" v-on:click="move(i, 1)" :disabled="i === list.length - 1" class="icon-btn !h-9 !w-9 !text-base disabled:opacity-30" :aria-label="'Move ' + t.title + ' down'">↓</button>
          <button type="button" v-on:click="remove(i)" class="icon-btn !h-9 !w-9 !text-base hover:!bg-flame hover:text-paper" :aria-label="'Remove ' + t.title">✕</button>
        </li>
      </ol>
      <p class="hint">Order here is the play order. Changes are saved when you press save.</p>
     </div>
    </div>
  }

  @if (!isNew)
  {
    <div class="mt-16 border-2 border-dashed border-flame p-6">
      <p class="eyebrow text-flame">/ Danger zone</p>
      <div class="mt-3 flex flex-wrap items-center justify-between gap-4">
        <p class="font-medium">Delete this playlist for good. People who saved it will lose it too.</p>
        @using (Html.BeginForm("Delete", "PlaylistsManage", new { id = f.Id }, FormMethod.Post, new { data_confirm = "Delete this playlist? This cannot be undone." }))
        {
          @Html.AntiForgeryToken()
          <button type="submit" class="btn-flame btn-sm">✕ Delete playlist</button>
        }
      </div>
    </div>
  }
</section>

@section Scripts {
<script>
  WL.island('playlist-editor', {
    props: ['tracks'],
    data() { return { list: [...(this.tracks || [])], query: '', results: [], loading: false, open: false, timer: null }; },
    computed: {
      totalTime() { return WL.fmt(this.list.reduce((s, t) => s + t.durationSec, 0)); },
    },
    methods: {
      fmt: WL.fmt,
      has(id) { return this.list.some((t) => t.id === id); },
      search() {
        clearTimeout(this.timer);
        this.open = true;
        this.loading = true;
        this.timer = setTimeout(async () => {
          try { this.results = await WL.api('/api/tracks/search?q=' + encodeURIComponent(this.query)); }
          catch { this.results = []; }
          finally { this.loading = false; }
        }, 220);
      },
      add(r) { if (!this.has(r.id)) this.list.push(r); },
      remove(i) { this.list.splice(i, 1); },
      move(i, d) {
        const j = i + d;
        if (j < 0 || j >= this.list.length) return;
        const [t] = this.list.splice(i, 1);
        this.list.splice(j, 0, t);
      },
    },
    mounted() {
      document.addEventListener('click', (e) => { if (!this.$el.contains(e.target)) this.open = false; });
    },
  });
</script>
}
